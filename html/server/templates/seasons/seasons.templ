package seasons

import (
	"fmt"

	model "github.com/srlmgr/backend/html/server/model"

	seriesTempl "github.com/srlmgr/backend/html/server/templates/series"

	"strings"

	"github.com/srlmgr/backend/html/server/util"
)

func navURL(url string) string {
	return util.ComposeNavURL((url))
}

templ SeasonsNav(c model.SeasonNav) {
	<nav class="bg-gray-800 text-white p-4">
		<div class="container mx-auto flex justify-between items-center">
			for _, s := range c.Seasons() {
				<a href={ fmt.Sprintf("%s/participants", navURL(util.SeasonsURL(s.ID))) } class="text-lg font-semibold">{ s.Name }</a>
				// <a href={fmt.Sprintf("%s/standings", seasonBasePath(c, s.ID))} class="text-lg font-semibold">{s.Name}</a>
			}
		</div>
	</nav>
}

func standingsPrimaryQueryParam(c model.SeasonNav) string {
	work := []string{}
	for _, q := range []string{"skipMode"} {
		if c.QueryParam().Has(q) {
			work = append(work, fmt.Sprintf("%s=%s", q, c.QueryParam().Get(q)))
		}
	}
	if len(work) == 0 {
		return ""
	}
	return "?" + strings.Join(work, "&")
}
func standingsSecondaryQueryParam(c model.SeasonNav) string {
	// TODO
	return ""
}

templ SeasonsMenu(c model.SeasonNav) {
	<nav class="bg-gray-800 text-white p-4">
		<div class="container mx-auto flex justify-between items-center">
			if c.Season().IsTeamBased {
				<a href={ fmt.Sprintf("%s/primary%s", navURL(util.SeasonsStandingsURL(int(c.Season().ID))), standingsPrimaryQueryParam(c)) } class="text-lg font-semibold">Teamwertung</a>
				<a href={ fmt.Sprintf("%s/secondary%s", navURL(util.SeasonsStandingsURL(int(c.Season().ID))), standingsSecondaryQueryParam(c)) } class="text-lg font-semibold">Fahrerwertung</a>
				// <a href={fmt.Sprintf("%s/secondary%s", c.StandingsLink(), c.ClearParams("eventID", "skipMode"))} class="text-lg font-semibold">Fahrerwertung</a>
				<a href={ fmt.Sprintf("%s/results/overview/primary", navURL(util.SeasonsURL(int(c.Season().ID)))) } class="text-lg font-semibold">Teamergebnisse</a>
				<a href={ fmt.Sprintf("%s/results/overview/secondary", navURL(util.SeasonsURL(int(c.Season().ID)))) } class="text-lg font-semibold">Fahrerergebnisse</a>
				// TODO: add link to participants
			} else {
				<a href={ fmt.Sprintf("%s/primary%s", navURL(util.SeasonsStandingsURL(int(c.Season().ID))), standingsPrimaryQueryParam(c)) } class="text-lg font-semibold">Fahrerwertung</a>
				<a href={ fmt.Sprintf("%s/secondary%s", navURL(util.SeasonsStandingsURL(int(c.Season().ID))), standingsSecondaryQueryParam(c)) } class="text-lg font-semibold">Teamwertung</a>
				<a href={ fmt.Sprintf("%s/results/overview/primary", navURL(util.SeasonsURL(int(c.Season().ID)))) } class="text-lg font-semibold">Fahrerergebnisse</a>
				<a href={ fmt.Sprintf("%s/results/overview/secondary", navURL(util.SeasonsURL(int(c.Season().ID)))) } class="text-lg font-semibold">Teamergebnisse</a>
				// TODO: add link to participants
			}
			<a href={ fmt.Sprintf("%s/participants", navURL(util.SeasonsURL(int(c.Season().ID)))) } class="text-lg font-semibold">Teilnehmer</a>
		</div>
	</nav>
}

func snippetBaseURL(c model.SeasonNav) string {
	return util.AdjustedSnippetURL("/snippet", c)
}

func snippetSeasonLink(c model.SeasonNav, view string, extra ...string) string {
	params := append([]string{fmt.Sprintf("view=%s", view), fmt.Sprintf("seasonID=%d", c.Season().ID)}, extra...)
	return fmt.Sprintf("%s?%s", snippetBaseURL(c), strings.Join(params, "&"))
}

func snippetStandingsLink(c model.SeasonNav, subview string) string {
	params := []string{fmt.Sprintf("view=standings"), fmt.Sprintf("seasonID=%d", c.Season().ID)}
	if subview != "" {
		params = append(params, fmt.Sprintf("subview=%s", subview))
	}
	for _, q := range []string{"classID", "skipMode"} {
		if c.QueryParam().Has(q) {
			params = append(params, fmt.Sprintf("%s=%s", q, c.QueryParam().Get(q)))
		}
	}
	return fmt.Sprintf("%s?%s", snippetBaseURL(c), strings.Join(params, "&"))
}

func snippetResultsLink(c model.SeasonNav, mode string) string {
	params := []string{fmt.Sprintf("view=results-overview"), fmt.Sprintf("seasonID=%d", c.Season().ID), fmt.Sprintf("mode=%s", mode)}
	for _, q := range []string{"classID"} {
		if c.QueryParam().Has(q) {
			params = append(params, fmt.Sprintf("%s=%s", q, c.QueryParam().Get(q)))
		}
	}
	return fmt.Sprintf("%s?%s", snippetBaseURL(c), strings.Join(params, "&"))
}

templ SnippetSeasonsNav(c model.SeasonNav) {
	<nav class="bg-gray-800 text-white p-4">
		<div class="container mx-auto flex justify-between items-center">
			for i := len(c.Seasons()) - 1; i >= 0; i-- {
				{{
					x := c.Seasons()[i]
					params := []string{"view=participants",
						fmt.Sprintf("seriesID=%s", c.QueryParam().Get("seriesID")),
						fmt.Sprintf("seasonID=%d", x.ID)}
				}}
				<a href={ fmt.Sprintf("%s?%s", snippetBaseURL(c), strings.Join(params, "&")) } class="text-lg font-semibold">{ x.Name }</a>
			}
		</div>
	</nav>
}

templ SnippetSeasonsMenu(c model.SeasonNav) {
	<nav class="bg-gray-800 text-white p-4">
		<div class="container mx-auto flex justify-between items-center">
			if c.Season().IsTeamBased {
				<a href={ snippetStandingsLink(c, "primary") } class="text-lg font-semibold">Teamwertung</a>
				<a href={ snippetStandingsLink(c, "secondary") } class="text-lg font-semibold">Fahrerwertung</a>
				<a href={ snippetResultsLink(c, "primary") } class="text-lg font-semibold">Teamergebnisse</a>
				<a href={ snippetResultsLink(c, "secondary") } class="text-lg font-semibold">Fahrerergebnisse</a>
			} else {
				<a href={ snippetStandingsLink(c, "primary") } class="text-lg font-semibold">Fahrerwertung</a>
				<a href={ snippetStandingsLink(c, "secondary") } class="text-lg font-semibold">Teamwertung</a>
				<a href={ snippetResultsLink(c, "primary") } class="text-lg font-semibold">Fahrerergebnisse</a>
				<a href={ snippetResultsLink(c, "secondary") } class="text-lg font-semibold">Teamergebnisse</a>
			}
			<a href={ snippetSeasonLink(c, "participants") } class="text-lg font-semibold">Teilnehmer</a>
		</div>
	</nav>
}

templ SeasonsContents(c model.SeasonNav) {
	@seriesTempl.SeriesNav(c.SeriesContainer())
	@SeasonsNav(c)
}
